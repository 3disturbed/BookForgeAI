# BookForgeAI configuration. Copy to .env at the repository root.
# SECURITY.md: every key here is server-side only and must never reach a browser.

NODE_ENV=development
PORT=3000
# Defaults to http://localhost:$PORT. Set this in a deployment.
APP_BASE_URL=

# SQLite database and local blob storage live under this directory.
DATA_DIR=./data

# --- OpenAI -----------------------------------------------------------------
# Required: agent jobs fail without it.
OPENAI_API_KEY=
# Optional override for an OpenAI-compatible gateway.
OPENAI_BASE_URL=
# Model routing. Agents ask for a capability; these resolve it (AGENTS.md).
# Leave blank to use the built-in default.
OPENAI_TEXT_MODEL=gpt-5
# Falls back to OPENAI_TEXT_MODEL when blank.
OPENAI_REASONING_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-2

# --- Pipeline ---------------------------------------------------------------
# SDD.md §7: maximum critique/rewrite cycles before escalating to a human.
MAX_REVISION_CYCLES=3
# Concurrent agent jobs per worker process.
AGENT_CONCURRENCY=3
# Set false to run the text pipeline without generating any images.
ENABLE_ILLUSTRATIONS=true

# --- Billing ----------------------------------------------------------------
# BILLING.md: the publishing charge, applied server-side. Never trust a client
# supplied amount.
BOOK_PUBLISHING_PRICE_USD=100
BOOK_PUBLISHING_CURRENCY=usd
# Leave blank to use the development checkout stand-in (refused in production).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Secrets ----------------------------------------------------------------
# Stable values keep sessions and signed file links valid across restarts.
SESSION_SECRET=
SIGNING_SECRET=
SIGNED_URL_TTL_SECONDS=300

# --- Optional infrastructure ------------------------------------------------
# The MVP uses SQLite, the local filesystem and an in-process queue. These are
# the seams for the Postgres / Redis / S3 targets in ARCHITECTURE.md.
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=bookforgeai
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Cost controls -----------------------------------------------------------
# Mechanical agents (asset-designer, scene-composer, image-director,
# copy-editor, publisher) route here instead of the frontier model.
OPENAI_LIGHT_MODEL=gpt-5-mini
# Reasoning effort per tier: minimal | low | medium | high.
OPENAI_REASONING_EFFORT=low
OPENAI_TEXT_EFFORT=low
OPENAI_LIGHT_EFFORT=minimal
# Image fidelity: low | medium | high | auto. `low` is the draft setting.
OPENAI_IMAGE_QUALITY=low

# --- PDF ---------------------------------------------------------------------
# puppeteer (default, real book typography) or pdfkit (no browser required).
PDF_RENDERER=puppeteer

# --- Rates (USD) -------------------------------------------------------------
# Copy the per-1M-token prices for the models you configured above from your
# vendor's pricing page: input, cached input and output for the text/reasoning
# tier and for the light tier; input and output tokens for gpt-image models.
# All default to zero, in which case the console reports payment fees only and
# says so. Never invent these.
RATE_TEXT_INPUT_PER_M=0
RATE_TEXT_CACHED_INPUT_PER_M=0
RATE_TEXT_OUTPUT_PER_M=0
RATE_LIGHT_INPUT_PER_M=0
RATE_LIGHT_CACHED_INPUT_PER_M=0
RATE_LIGHT_OUTPUT_PER_M=0
RATE_IMAGE_INPUT_PER_M=0
RATE_IMAGE_OUTPUT_PER_M=0
# Flat per-image fallback for image models that report no token usage.
RATE_PER_IMAGE=0
# Multiplier for tokens sent through the Batch API (e.g. 0.5). 1 until measured.
RATE_BATCH_MULTIPLIER=1
RATE_STORAGE_PER_GB_MONTH=0
RATE_COMPUTE_PER_HOUR=0
RATE_PAYMENT_PERCENT=0.029
RATE_PAYMENT_FIXED=0.3
